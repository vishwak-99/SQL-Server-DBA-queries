SELECT *
FROM YourTable
WHERE TRY_CONVERT(DATE,
        CASE
            -- Format: yyyy-mm-dd (ISO)
            WHEN YourColumn LIKE '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
                THEN YourColumn

            -- Format: m/d/yyyy or mm/dd/yyyy
            WHEN YourColumn LIKE '%/%/%'
                THEN TRY_CONVERT(VARCHAR, TRY_CONVERT(DATE, YourColumn, 101), 23)

            -- Format: dd-mm-yyyy
            WHEN YourColumn LIKE '[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9]'
                THEN TRY_CONVERT(VARCHAR, TRY_CONVERT(DATE, YourColumn, 105), 23)
        END
      ) < DATEADD(YEAR, -3, GETDATE());
